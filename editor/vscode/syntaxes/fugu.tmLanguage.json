{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fugu",
  "scopeName": "source.fugu",
  "fileTypes": ["f", "fg", "fugu"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fugu",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.fugu",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fugu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fugu",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.fugu",
              "begin": "(?:\\$|&)\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.fugu" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.fugu" }
              },
              "patterns": [
                { "include": "#interpolation-braces" },
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.raw.fugu",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "interpolation-braces": {
      "patterns": [
        {
          "name": "meta.brace.block.fugu",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.block.begin.fugu" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.fugu" }
          },
          "patterns": [
            { "include": "#interpolation-braces" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.fugu",
          "match": "'(?:\\\\.|[^\\\\'])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.imaginary.fugu",
          "match": "\\b(?:\\d+\\.\\d+|\\d+)i\\b"
        },
        {
          "name": "constant.numeric.float.fugu",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.fugu",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fugu",
          "match": "\\b(?:return|match|switch|case|if|else|for|range|continue|break|goto|defer|select)\\b"
        },
        {
          "name": "keyword.other.module.fugu",
          "match": "\\b(?:module|use)\\b"
        },
        {
          "name": "storage.type.fugu",
          "match": "\\b(?:fn|let|mut|const|type|enum|struct|interface|pub)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.type.primitive.fugu",
          "match": "\\b(?:bool|char|str|int|i8|i16|i32|i64|uint|u8|u16|u32|u64|float|f32|f64|complex|void)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.module.declaration.fugu",
          "match": "\\b(module)\\s+([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.other.module.fugu" },
            "2": { "name": "entity.name.namespace.fugu" }
          }
        },
        {
          "name": "meta.function.definition.fugu",
          "match": "\\b(fn)\\s+([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.function.fugu" },
            "2": { "name": "entity.name.function.fugu" }
          }
        },
        {
          "name": "meta.type.definition.fugu",
          "match": "\\b(struct|enum|interface|type)\\s+([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(<)\\s*([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(>)",
          "captures": {
            "1": { "name": "storage.type.fugu" },
            "2": { "name": "entity.name.type.fugu" },
            "3": { "name": "punctuation.definition.generic.begin.fugu" },
            "4": { "name": "entity.name.type.parameter.fugu" },
            "5": { "name": "punctuation.definition.generic.end.fugu" }
          }
        },
        {
          "name": "meta.type.definition.fugu",
          "match": "\\b(struct|enum|interface|type)\\s+([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.fugu" },
            "2": { "name": "entity.name.type.fugu" }
          }
        },
        {
          "name": "meta.variable.definition.fugu",
          "match": "\\b(let|const)\\s+([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.fugu" },
            "2": { "name": "variable.other.definition.fugu" }
          }
        },
        {
          "name": "meta.function.call.fugu",
          "match": "\\b([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.fugu" }
          }
        },
        {
          "name": "meta.path.call.fugu",
          "match": "\\b([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)::([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.fugu" },
            "2": { "name": "entity.name.function.call.fugu" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "meta.return.type.fugu",
          "match": "(->)\\s*([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(<)\\s*([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(>)",
          "captures": {
            "1": { "name": "keyword.operator.flow.fugu" },
            "2": { "name": "entity.name.type.fugu" },
            "3": { "name": "punctuation.definition.generic.begin.fugu" },
            "4": { "name": "entity.name.type.fugu" },
            "5": { "name": "punctuation.definition.generic.end.fugu" }
          }
        },
        {
          "name": "meta.return.type.fugu",
          "match": "(->)\\s*([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.operator.flow.fugu" },
            "2": { "name": "entity.name.type.fugu" }
          }
        },
        {
          "name": "meta.type.annotation.fugu",
          "match": "(:)\\s*(?:(mut)\\s+)?([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(<)\\s*([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(>)",
          "captures": {
            "1": { "name": "punctuation.separator.fugu" },
            "2": { "name": "storage.type.fugu" },
            "3": { "name": "entity.name.type.fugu" },
            "4": { "name": "punctuation.definition.generic.begin.fugu" },
            "5": { "name": "entity.name.type.fugu" },
            "6": { "name": "punctuation.definition.generic.end.fugu" }
          }
        },
        {
          "name": "meta.type.annotation.fugu",
          "match": "(:)\\s*(?:(mut)\\s+)?([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.fugu" },
            "2": { "name": "storage.type.fugu" },
            "3": { "name": "entity.name.type.fugu" }
          }
        },
        {
          "name": "meta.generic.type.fugu",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(<)\\s*([A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*)\\s*(>)",
          "captures": {
            "1": { "name": "entity.name.type.fugu" },
            "2": { "name": "punctuation.definition.generic.begin.fugu" },
            "3": { "name": "entity.name.type.fugu" },
            "4": { "name": "punctuation.definition.generic.end.fugu" }
          }
        },
        {
          "name": "entity.name.type.fugu",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.fugu",
          "match": "(?:\\.\\.=|\\.\\.<|\\.\\.\\.|\\.\\.)"
        },
        {
          "name": "keyword.operator.flow.fugu",
          "match": "(?:=>|->|\\|>|\\?:|\\?\\.|<-|\\?)"
        },
        {
          "name": "keyword.operator.logical.fugu",
          "match": "(?:&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.bitwise.fugu",
          "match": "(?:<<|>>|~|&)"
        },
        {
          "name": "keyword.operator.assignment.fugu",
          "match": "(?:\\+=|-=|\\*=|/=|%=|\\^=|=)"
        },
        {
          "name": "keyword.operator.comparison.fugu",
          "match": "(?:==|!=|<=|>=|<|>|!)"
        },
        {
          "name": "keyword.operator.arithmetic.fugu",
          "match": "(?:\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.accessor.fugu",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.fugu",
          "match": "[:,;]"
        },
        {
          "name": "punctuation.definition.group.fugu",
          "match": "[(){}\\[\\]]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.fugu",
          "match": "\\b[A-Za-z_\\x{00AA}-\\x{10FFFF}][\\p{L}\\p{N}_]*\\b"
        }
      ]
    }
  }
}
